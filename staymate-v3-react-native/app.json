{
  "expo": {
    "name": "StayMate V3",
    "slug": "staymate-v3",
    "version": "3.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "staymate",
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sameer8822.staymatev3",
      "icon": "./assets/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.sameer8822.staymatev3"
    },
    "plugins": [
      "expo-sharing"
    ]
  }
}
